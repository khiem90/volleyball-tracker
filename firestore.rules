rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAccount(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Signed in with a real account. signedIn() also passes the silent
    // anonymous identity a scorer link gives a phone; this does not, so
    // an RSVP and the name behind it always belong to an account.
    function realAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // The account's own document. It holds the name the account last
    // RSVP'd under, so the RSVP form can offer it again. Only that account
    // reads or writes it.
    match /users/{uid} {
      allow read, delete: if realAccount() && request.auth.uid == uid;
      allow create, update: if
        realAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['rsvpName'])
        && request.resource.data.rsvpName is string
        && request.resource.data.rsvpName.size() >= 1
        && request.resource.data.rsvpName.size() <= 40;
    }

    // Roster: the teams an account keeps between tournaments. Only that
    // account can see or change them; there is no public path to a roster.
    match /users/{uid}/teams/{teamId} {
      allow read, write: if isAccount(uid);
    }

    // Quick matches belong to no tournament and are private to the account.
    // They sit in a collection also called "matches" so the account-wide
    // collection group query below returns them alongside tournament matches.
    match /users/{uid}/matches/{matchId} {
      allow read, delete: if isAccount(uid);
      allow create, update: if
        isAccount(uid)
        && request.resource.data.ownerId == uid
        && request.resource.data.tournamentId == null;
    }

    // Tournaments are owned by the account that created them. The owner
    // writes anything. A scorer, a phone holding the scorer link, may record
    // results, reorder the queue, and swap courts while the tournament is
    // live, and nothing else. Either one's write that moves the revision
    // must be built on the stored revision. Anyone holding the link can read
    // while the spectator link is on; with it off, only the owner and
    // scorers can read the tournament or its matches.
    match /tournaments/{tournamentId} {
      function tournament() {
        return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
      }

      function ownsTournament() {
        return signedIn() && tournament().ownerId == request.auth.uid;
      }

      function scorerKey() {
        return get(/databases/$(database)/documents/tournaments/$(tournamentId)/private/scorerKey).data.key;
      }

      // A scorer is a signed-in identity whose proof carries the current
      // key. Regenerating the key changes what this compares against, so
      // every proof written for the old key fails from then on. A missing
      // proof or key makes the get() fail, which denies.
      function isScorer() {
        return signedIn()
          && get(/databases/$(database)/documents/tournaments/$(tournamentId)/scorers/$(request.auth.uid)).data.key
            == scorerKey();
      }

      function isLive() {
        return tournament().status == 'live';
      }

      // Every write that moves the revision says which revision it was
      // built on, in `basedOn`, and is refused when that is no longer the
      // stored one. This is the concurrency check for the whole tournament
      // (see ADR-0003): a phone that built a result on a copy another phone
      // has since moved past loses here, not by overwriting. A write that
      // leaves the revision alone is not asked for a base.
      function movesRevision() {
        return request.resource.data.revision != resource.data.revision;
      }

      function basedOnStoredRevision() {
        return !movesRevision()
          || request.resource.data.get('basedOn', null) == resource.data.revision;
      }

      // A result or a court edit may change the tournament's rotation state
      // and must move the revision, with its base, so it is checked above
      // like every other result. The last result of a round robin or a
      // bracket also completes the tournament, so a scorer may move one of
      // those to completed when a winner from its teams comes with it. End
      // names no winner and stays with the owner, and the rotation formats
      // finish only through End. The rules cannot see whether every match
      // has been played, so a scorer writing to Firestore outside the app
      // could complete a round robin or a bracket early (see ADR-0002).
      function scorerChange() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return movesRevision()
          && changed.hasOnly([
            'revision', 'basedOn', 'updatedAt', 'win2outState', 'twoMatchRotationState',
            'status', 'completedAt', 'winnerId'
          ])
          && (!changed.hasAny(['status', 'completedAt', 'winnerId'])
            || (request.resource.data.status == 'completed'
              && resource.data.format in ['round_robin', 'single_elimination', 'double_elimination']
              && request.resource.data.winnerId in resource.data.teamIds));
      }

      // A tournament with its RSVP link on must say when it is and when
      // RSVPs open, so the RSVP page can never be shared without them. The
      // RSVP settings and the scheduled time are not in scorerChange's
      // list, so only the owner writes them.
      function rsvpHasItsTimes(data) {
        return !('rsvp' in data)
          || data.rsvp.get('enabled', false) != true
          || (data.get('scheduledAt', null) is number
            && data.rsvp.get('opensAt', null) is number);
      }

      // Whether the RSVP link is on. A tournament from before RSVPs has no
      // rsvp map and reads as off.
      function rsvpLinkOn(data) {
        return data.get('rsvp', {}).get('enabled', false) == true;
      }

      // The third door: any real account holding the RSVP link reads the
      // tournament while the link is on.
      allow read: if
        (signedIn() && resource.data.ownerId == request.auth.uid)
        || resource.data.spectatorEnabled == true
        || isScorer()
        || (realAccount() && rsvpLinkOn(resource.data));

      allow create: if
        signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && rsvpHasItsTimes(request.resource.data);

      allow update: if
        basedOnStoredRevision()
        && rsvpHasItsTimes(request.resource.data)
        && ((signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
          || (resource.data.status == 'live' && isScorer() && scorerChange()));

      allow delete: if
        signedIn() && resource.data.ownerId == request.auth.uid;

      // The scorer key is the secret behind the scorer link. It lives apart
      // from the tournament so a spectator, who can read the tournament,
      // never sees it. Only the owner reads or writes it.
      match /private/{document} {
        allow read, write: if ownsTournament();
      }

      // A scorer's proof is the key from the link the phone opened, written
      // under that phone's own uid. The rules accept a proof only while its
      // key is the current one, so a phone on a regenerated link learns at
      // once that it is stale, and a proof can never hold anything but a
      // key that was valid when it was written. The owner can list and
      // remove proofs; a phone sees only its own.
      match /scorers/{uid} {
        allow read, delete: if ownsTournament() || isAccount(uid);
        allow create, update: if
          isAccount(uid)
          && request.resource.data.keys().hasOnly(['key', 'updatedAt'])
          && request.resource.data.key == scorerKey();
      }

      // One RSVP per account, under the account's uid, so a person holds at
      // most one per tournament. Nothing stores who is confirmed or
      // waiting: every phone works that out from the arrival times and the
      // capacity (ADR-0004). The rules cannot count the list, so they never
      // refuse an RSVP for being over capacity; they refuse it before the
      // open time by the server's clock, and they make the server's time
      // the arrival time, so no phone's clock takes part in the order.
      match /rsvps/{rsvpId} {
        function mayReadRsvps() {
          return ownsTournament() || (realAccount() && rsvpLinkOn(tournament()));
        }

        // The link is on, the owner has not closed the list, the tournament
        // has not started, and the server's clock has reached the open time.
        function rsvpsAreOpen() {
          let night = tournament();
          return rsvpLinkOn(night)
            && night.rsvp.get('closed', false) != true
            && night.status == 'draft'
            && request.time.toMillis() >= night.rsvp.opensAt;
        }

        function rsvpFieldsAreValid(data) {
          return data.keys().hasAll(['uid', 'name', 'createdAt'])
            && data.keys().hasOnly(['uid', 'name', 'createdAt', 'note'])
            && data.name is string
            && data.name.size() >= 1
            && data.name.size() <= 40
            && (!('note' in data) || (data.note is string && data.note.size() <= 140));
        }

        allow read: if mayReadRsvps();

        allow create: if
          realAccount()
          && rsvpId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && rsvpFieldsAreValid(request.resource.data)
          && request.resource.data.createdAt == request.time
          && rsvpsAreOpen();

        // The account's own RSVP, which a held spot never is: it has no uid.
        function isOwnRsvp() {
          return realAccount()
            && rsvpId == request.auth.uid
            && resource.data.uid == request.auth.uid;
        }

        // A person fixes their name or note without losing their place:
        // the arrival time and the uid never change, so neither does the
        // order. This works after a close too, like a withdrawal.
        allow update: if
          isOwnRsvp()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'note'])
          && rsvpFieldsAreValid(request.resource.data);

        // A withdrawal is a delete, open until the tournament starts, even
        // after the owner closes the list. RSVPing again is a new create
        // with a new arrival time, which is the back of the line.
        allow delete: if isOwnRsvp() && tournament().status == 'draft';
      }

      // One document per match. A match carries its owner and tournament ids
      // so the account-wide query below can be checked without a parent read.
      // A scorer writes matches while the tournament is live: a score, a
      // result, the next match on a court, and the match an undo removes.
      match /matches/{matchId} {
        function mayWriteMatches() {
          return ownsTournament() || (isLive() && isScorer());
        }

        allow read: if
          ownsTournament() || tournament().spectatorEnabled == true || isScorer();

        allow create: if
          mayWriteMatches()
          && request.resource.data.ownerId == tournament().ownerId
          && request.resource.data.tournamentId == tournamentId;

        allow update: if
          mayWriteMatches()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.tournamentId == resource.data.tournamentId;

        allow delete: if mayWriteMatches();
      }
    }

    // The account-wide match query (History, team records) is a collection
    // group query, which needs a rule on this wildcard path. The query filters
    // on ownerId, so the rule can be proven from the filter alone.
    match /{path=**}/matches/{matchId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // User formations collection (for custom volleyball formations)
    match /formations/{formationId} {
      // Read allowed if:
      // 1. User is the owner
      // 2. Formation is unlisted (shareable)
      allow read: if
        (request.auth != null && resource.data.ownerUserId == request.auth.uid)
        || resource.data.visibility == "unlisted";

      // Create allowed if authenticated and setting self as owner
      allow create: if
        request.auth != null
        && request.resource.data.ownerUserId == request.auth.uid;

      // Update/delete allowed only by owner
      allow update, delete: if
        request.auth != null
        && resource.data.ownerUserId == request.auth.uid;
    }
  }
}
