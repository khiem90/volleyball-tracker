rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAccount(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Signed in with a real account. signedIn() also passes the silent
    // anonymous identity a scorer link gives a phone; this does not, so
    // an RSVP and the name behind it always belong to an account.
    function realAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // The fields an account's own RSVP to a list may hold.
    function rsvpFieldsAreValid(data) {
      return data.keys().hasAll(['uid', 'name', 'createdAt'])
        && data.keys().hasOnly(['uid', 'name', 'createdAt', 'note', 'noticesReadAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && (!('note' in data) || (data.note is string && data.note.size() <= 140))
        && (!('noticesReadAt' in data) || data.noticesReadAt is timestamp);
    }

    // The account's own document. It holds the name the account last
    // RSVP'd under, so the RSVP form can offer it again. Only that account
    // reads or writes it, and nobody deletes it.
    match /users/{uid} {
      allow read: if realAccount() && request.auth.uid == uid;
      allow create, update: if
        realAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['rsvpName'])
        && request.resource.data.rsvpName is string
        && request.resource.data.rsvpName.size() >= 1
        && request.resource.data.rsvpName.size() <= 40;
    }

    // Roster: the teams an account keeps between tournaments. Only that
    // account can see or change them; there is no public path to a roster.
    match /users/{uid}/teams/{teamId} {
      allow read, write: if isAccount(uid);
    }

    // Quick matches belong to no tournament and are private to the account.
    // They sit in a collection also called "matches" so the account-wide
    // collection group query below returns them alongside tournament matches.
    match /users/{uid}/matches/{matchId} {
      allow read, delete: if isAccount(uid);
      allow create, update: if
        isAccount(uid)
        && request.resource.data.ownerId == uid
        && request.resource.data.tournamentId == null;
    }

    // Tournaments are owned by the account that created them. The owner
    // writes anything. A scorer, a phone holding the scorer link, may record
    // results, reorder the queue, and swap courts while the tournament is
    // live, and nothing else. Either one's write that moves the revision
    // must be built on the stored revision. Anyone holding the link can read
    // while the spectator link is on; with it off, only the owner and
    // scorers can read the tournament or its matches.
    match /tournaments/{tournamentId} {
      function tournament() {
        return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
      }

      function ownsTournament() {
        return signedIn() && tournament().ownerId == request.auth.uid;
      }

      function scorerKey() {
        return get(/databases/$(database)/documents/tournaments/$(tournamentId)/private/scorerKey).data.key;
      }

      // A scorer is a signed-in identity whose proof carries the current
      // key. Regenerating the key changes what this compares against, so
      // every proof written for the old key fails from then on. A missing
      // proof or key makes the get() fail, which denies.
      function isScorer() {
        return signedIn()
          && get(/databases/$(database)/documents/tournaments/$(tournamentId)/scorers/$(request.auth.uid)).data.key
            == scorerKey();
      }

      function isLive() {
        return tournament().status == 'live';
      }

      // Every write that moves the revision says which revision it was
      // built on, in `basedOn`, and is refused when that is no longer the
      // stored one. This is the concurrency check for the whole tournament
      // (see ADR-0003): a phone that built a result on a copy another phone
      // has since moved past loses here, not by overwriting. A write that
      // leaves the revision alone is not asked for a base.
      function movesRevision() {
        return request.resource.data.revision != resource.data.revision;
      }

      function basedOnStoredRevision() {
        return !movesRevision()
          || request.resource.data.get('basedOn', null) == resource.data.revision;
      }

      // A result or a court edit may change the tournament's rotation state
      // and must move the revision, with its base, so it is checked above
      // like every other result. The last result of a round robin or a
      // bracket also completes the tournament, so a scorer may move one of
      // those to completed when a winner from its teams comes with it. End
      // names no winner and stays with the owner, and the rotation formats
      // finish only through End. The rules cannot see whether every match
      // has been played, so a scorer writing to Firestore outside the app
      // could complete a round robin or a bracket early (see ADR-0002).
      function scorerChange() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return movesRevision()
          && changed.hasOnly([
            'revision', 'basedOn', 'updatedAt', 'win2outState', 'twoMatchRotationState',
            'status', 'completedAt', 'winnerId'
          ])
          && (!changed.hasAny(['status', 'completedAt', 'winnerId'])
            || (request.resource.data.status == 'completed'
              && resource.data.format in ['round_robin', 'single_elimination', 'double_elimination']
              && request.resource.data.winnerId in resource.data.teamIds));
      }

      allow read: if
        (signedIn() && resource.data.ownerId == request.auth.uid)
        || resource.data.spectatorEnabled == true
        || isScorer();

      allow create: if
        signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if
        basedOnStoredRevision()
        && ((signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
          || (resource.data.status == 'live' && isScorer() && scorerChange()));

      allow delete: if
        signedIn() && resource.data.ownerId == request.auth.uid;

      // The scorer key is the secret behind the scorer link. It lives apart
      // from the tournament so a spectator, who can read the tournament,
      // never sees it. Only the owner reads or writes it.
      match /private/{document} {
        allow read, write: if ownsTournament();
      }

      // A scorer's proof is the key from the link the phone opened, written
      // under that phone's own uid. The rules accept a proof only while its
      // key is the current one, so a phone on a regenerated link learns at
      // once that it is stale, and a proof can never hold anything but a
      // key that was valid when it was written. The owner can list and
      // remove proofs; a phone sees only its own.
      match /scorers/{uid} {
        allow read, delete: if ownsTournament() || isAccount(uid);
        allow create, update: if
          isAccount(uid)
          && request.resource.data.keys().hasOnly(['key', 'updatedAt'])
          && request.resource.data.key == scorerKey();
      }

      // A tournament from before RSVP lists took RSVPs of its own, and may
      // still hold them and the owner's notices (ADR-0005). The app no
      // longer reads or writes either. The owner alone can read and delete
      // them, which is what deleting the tournament needs to sweep them.
      match /rsvps/{rsvpId} {
        allow read, delete: if ownsTournament();
      }

      match /notices/{noticeId} {
        allow read, delete: if ownsTournament();
      }

      // One document per match. A match carries its owner and tournament ids
      // so the account-wide query below can be checked without a parent read.
      // A scorer writes matches while the tournament is live: a score, a
      // result, the next match on a court, and the match an undo removes.
      match /matches/{matchId} {
        function mayWriteMatches() {
          return ownsTournament() || (isLive() && isScorer());
        }

        // The same doors as the tournament: the owner, the spectator link,
        // and a scorer.
        allow read: if
          ownsTournament()
          || tournament().spectatorEnabled == true
          || isScorer();

        allow create: if
          mayWriteMatches()
          && request.resource.data.ownerId == tournament().ownerId
          && request.resource.data.tournamentId == tournamentId;

        allow update: if
          mayWriteMatches()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.tournamentId == resource.data.tournamentId;

        allow delete: if mayWriteMatches();
      }
    }

    // An RSVP list stands on its own, with no tournament behind it, and is
    // owned by the account that created it (ADR-0005). Only a real account
    // owns one, so the silent identity a scorer link gives a phone never
    // does. The owner reads and writes it. Any other real account reads it
    // while the RSVP link is on, and nobody else reads it at all.
    match /rsvpLists/{listId} {
      function ownsList(data) {
        return realAccount() && data.ownerId == request.auth.uid;
      }

      // A list takes RSVPs by person or by team, and nothing else.
      function takesIsValid(data) {
        return data.get('takes', null) in ['people', 'teams'];
      }

      // A list with its RSVP link on must say when it is and when RSVPs
      // open, so the RSVP page can never be shared without them.
      function listHasItsTimes(data) {
        return data.get('enabled', false) != true
          || (data.get('scheduledAt', null) is number
            && data.get('opensAt', null) is number);
      }

      allow read: if
        ownsList(resource.data)
        || (realAccount() && resource.data.enabled == true);

      allow create: if
        ownsList(request.resource.data)
        && takesIsValid(request.resource.data)
        && listHasItsTimes(request.resource.data);

      allow update: if
        ownsList(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && takesIsValid(request.resource.data)
        && listHasItsTimes(request.resource.data);

      allow delete: if ownsList(resource.data);

      function list() {
        return get(/databases/$(database)/documents/rsvpLists/$(listId)).data;
      }

      // A list is over once the server's clock reaches its scheduled time.
      // A list with no scheduled time is not over.
      function listIsOver(data) {
        return data.get('scheduledAt', null) is number
          && request.time.toMillis() >= data.scheduledAt;
      }

      // One RSVP per account, under the account's uid, so an account holds
      // at most one per list. Nothing stores who is confirmed or waiting.
      // Every phone works that out from the arrival times and the capacity
      // (ADR-0004). The rules cannot count the list, so they never refuse
      // an RSVP for being over capacity. They hold both of the list's times
      // to the server's clock, and they make the server's time the arrival
      // time, so no phone's clock takes part in the order.
      match /rsvps/{rsvpId} {
        // The link is on, the owner has not closed the list, and the
        // server's clock is at or past the open time and before the
        // scheduled time. A list with its link on has both times.
        function rsvpsAreOpen() {
          let current = list();
          return current.enabled == true
            && current.get('closed', false) != true
            && request.time.toMillis() >= current.opensAt
            && !listIsOver(current);
        }

        // The account's own RSVP.
        function isOwnRsvp() {
          return realAccount()
            && rsvpId == request.auth.uid
            && resource.data.uid == request.auth.uid;
        }

        allow read: if ownsList(list()) || (realAccount() && list().enabled == true);

        allow create: if
          realAccount()
          && rsvpId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && rsvpFieldsAreValid(request.resource.data)
          && request.resource.data.createdAt == request.time
          // A read time sent with the RSVP is the server's, as when it is recorded later.
          && request.resource.data.get('noticesReadAt', request.time) == request.time
          && rsvpsAreOpen();

        // A held spot is the owner's RSVP for someone without an account,
        // under a generated id with no uid, so no account can ever change
        // or withdraw it. It takes its place in arrival order like any
        // other RSVP, so its arrival time is the server's too. The owner
        // adds one until the scheduled time, or on a list that has none
        // yet. The open time, a close, and the link being off stop RSVPs
        // from accounts and not the owner's held spots. Nobody updates one.
        allow create: if
          ownsList(list())
          && !listIsOver(list())
          && request.resource.data.keys().hasAll(['uid', 'held', 'name', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'held', 'name', 'createdAt'])
          && request.resource.data.uid == null
          && request.resource.data.held == true
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 40
          && request.resource.data.createdAt == request.time;

        // A person fixes their name or note without losing their place.
        // The arrival time and the uid never change, so neither does the
        // order. This works after a close too, like a withdrawal, and like
        // a withdrawal it stops at the scheduled time. The check sits on
        // this rule alone, so it bounds the name and the note and no other
        // field an account may write on its own RSVP.
        allow update: if
          isOwnRsvp()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'note'])
          && rsvpFieldsAreValid(request.resource.data)
          && !listIsOver(list());

        // The owner removes anyone, a held spot included, at any time. The
        // delete of a whole list relies on it after the scheduled time.
        allow delete: if ownsList(list());

        // A withdrawal is a delete, open until the scheduled time, even
        // after the owner closes the list. RSVPing again is a new create
        // with a new arrival time, which is the back of the line.
        allow delete: if isOwnRsvp() && !listIsOver(list());

        // When the account last opened the list's page, which Home compares
        // with the newest notice. Only the RSVP's own account records it,
        // always as the server's time, and nothing else changes with it.
        // The scheduled time does not stop it, since the owner still posts
        // notices after it.
        allow update: if
          isOwnRsvp()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noticesReadAt'])
          && request.resource.data.noticesReadAt == request.time;
      }

      // A notice is a short message the owner posts for everyone on the
      // list, confirmed or waiting. Only the owner posts or deletes one,
      // and nobody edits one. Neither stops at the scheduled time, so
      // "courts are running late" still goes out.
      match /notices/{noticeId} {
        // The same readers as the RSVPs.
        allow read: if ownsList(list()) || (realAccount() && list().enabled == true);

        allow create: if
          ownsList(list())
          && request.resource.data.keys().hasAll(['body', 'createdAt'])
          && request.resource.data.keys().hasOnly(['body', 'createdAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 500
          && request.resource.data.createdAt == request.time;

        allow delete: if ownsList(list());
      }
    }

    // The account-wide match query (History, team records) is a collection
    // group query, which needs a rule on this wildcard path. The query filters
    // on ownerId, so the rule can be proven from the filter alone.
    match /{path=**}/matches/{matchId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Home lists the RSVP lists an account is on with a collection group
    // query on its uid, which this wildcard rule proves from the filter. It
    // reads the account's own RSVPs whether or not each link is still on.
    // The list behind each one is read through its RSVP link as usual. The
    // rule cannot tell a list from a tournament, so it also returns the
    // account's own RSVP left under a tournament from before RSVP lists,
    // which Home leaves out. A held spot has no uid, so it is nobody's.
    match /{path=**}/rsvps/{rsvpId} {
      allow read: if realAccount() && resource.data.uid == request.auth.uid;
    }

    // User formations collection (for custom volleyball formations)
    match /formations/{formationId} {
      // Read allowed if:
      // 1. User is the owner
      // 2. Formation is unlisted (shareable)
      allow read: if
        (request.auth != null && resource.data.ownerUserId == request.auth.uid)
        || resource.data.visibility == "unlisted";

      // Create allowed if authenticated and setting self as owner
      allow create: if
        request.auth != null
        && request.resource.data.ownerUserId == request.auth.uid;

      // Update/delete allowed only by owner
      allow update, delete: if
        request.auth != null
        && resource.data.ownerUserId == request.auth.uid;
    }
  }
}
